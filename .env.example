# Copy to backend/.env:  cp .env.example backend/.env
#
# backend/.env is read by the backend's Settings class, which uses only the
# settings shown in this file (LLM_*, legacy GEMINI_* aliases, NEO4J_*,
# EXPORT_DIR). An unknown LLM_* / GEMINI_* key stops startup (it's a typo, and
# ignoring it could send your key to the wrong provider); any other unknown key
# is ignored with a warning.
# These are read from the process environment only, so export them or prefix
# the command instead of putting them here:
#   - LLM_MOCK (legacy: GEMINI_MOCK): fake LLM client with deterministic output,
#     no key or endpoint needed. Run: LLM_MOCK=true make backend
#   - OPENAI_API_KEY: picked up only by the openai provider when LLM_API_KEY is
#     empty and LLM_BASE_URL is unset (i.e. api.openai.com).
#   - Server-side variables such as OLLAMA_CONTEXT_LENGTH belong in the LLM
#     server's environment, not here.

# MIDI/JSON export root, relative to backend/ (default shown).
# EXPORT_DIR=exports

# Neo4j
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=explorator_dev

# ── LLM provider ────────────────────────────────────────────────────────────
# gemini (default) | openai  (any OpenAI-compatible endpoint: OpenAI, vLLM,
# Ollama, LM Studio, OpenRouter). Legacy GEMINI_* names still work but are
# deprecated — a warning is logged at startup. They are honoured ONLY with the
# gemini provider; under openai they are not used (a startup warning names
# each one), so a Google key is never sent to a third-party endpoint. The
# openai provider requires LLM_PRO_MODEL and LLM_FLASH_MODEL; unknown provider
# values fail at startup.
LLM_PROVIDER=gemini
LLM_API_KEY=your-api-key-here
# LLM_PRO_MODEL=gemini-pro-latest
# LLM_FLASH_MODEL=gemini-flash-latest

# To use one of the recipes below, uncomment its lines (they override the
# values above). Local servers usually ignore the key; set LLM_API_KEY to your
# server's key if it checks one (OpenRouter, vLLM started with --api-key).

# Ollama (note the /v1 suffix). Raise the context window on the Ollama server
# (OLLAMA_CONTEXT_LENGTH in its environment) and tell Explorator about it.
# qwen3 is a reasoning model: disable thinking (see LLM_EXTRA_BODY below) or
# pick a non-reasoning model, otherwise calls can run past LLM_TIMEOUT_SECONDS.
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_PRO_MODEL=qwen3:32b
# LLM_FLASH_MODEL=qwen3:8b
# LLM_CONTEXT_TOKENS=16384

# vLLM:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://gpu-box:8000/v1
# LLM_PRO_MODEL=Qwen/Qwen3-32B
# LLM_FLASH_MODEL=Qwen/Qwen3-32B
# Qwen3's chat template turns reasoning off with enable_thinking:
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# ── Optional tuning ─────────────────────────────────────────────────────────
# LLM_TIMEOUT_SECONDS applies to both providers (default 120 for gemini,
# 300 for openai). The rest are openai-only; defaults shown.
# LLM_TIMEOUT_SECONDS=300
# LLM_MAX_CONCURRENCY=4
# LLM_MAX_RETRIES=1

# JSON object merged into every openai-provider request body (one line).
# Use it to disable thinking on local reasoning models; the key depends on
# the model's chat template ("thinking" here, "enable_thinking" for Qwen3).
# Explorator sends no temperature, so the server's default sampling applies;
# a server that defaults to greedy decoding returns identical results for
# the same prompt.
# LLM_EXTRA_BODY={"chat_template_kwargs":{"thinking":false}}

# Cost estimate, USD per 1M tokens (example values). Gemini has built-in
# defaults for any you leave out. For openai, leave all four out to show
# "not priced"; if you set one, set all four (unset ones count as 0).
# Never leave a value empty.
# LLM_PRICE_PRO_INPUT=0.50
# LLM_PRICE_PRO_OUTPUT=1.50
# LLM_PRICE_FLASH_INPUT=0.10
# LLM_PRICE_FLASH_OUTPUT=0.40
